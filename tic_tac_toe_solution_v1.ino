/*
 * Task 1: Hardware Abstraction
 * Map logical button indices (0-8) to physical microcontroller pins.
 */
void setPins() {
  /* Confirmed mapping: D2-D4, D7-D9, D10-D12 */
  int buttonValues[9] = {2, 3, 4, 7, 8, 9, 10, 11, 12};

  for (int i = 0; i < 9; i++) {
      buttonPins[i] = buttonValues[i]; 
  }
}

/*
 * Task 2: Library Initialization
 * Configure and initialize the FastLED library.
 */
void fastLedSetup() {
  /* Initialize Main Strip */
  FastLED.addLeds<LED_TYPE, STRIP_PIN, COLOR_ORDER>(leds, NUM_LEDS);
  
  /* Initialize Status LED */
  FastLED.addLeds<LED_TYPE, STATUS_LED_PIN, COLOR_ORDER>(statusLed, 1);

  FastLED.setBrightness(BRIGHTNESS);
  FastLED.clear();
  FastLED.show();
}

/*
 * Task 3: LED Control
 * Helper function to turn off a specific LED.
 */
void ledBlack(int i) {
  leds[i] = CRGB::Black;
}

/*
 * Task 4: Game Logic - Reset
 * Reset player state to default (Player X starts).
 * Reset setup flag to trigger intro animation again.
 */
void resetPlayer() {
  currentPlayer = true; 
}

/*
 * Task 5: Game Logic - Player Switch
 * Toggle the active player and set the change flag.
 */
void changePlayer() {
  currentPlayer = !currentPlayer; 
  playerChanged = true; 
}

/*
 * Task 6: Input Handling
 * Poll buttons and detect falling edges (press events).
 */
void checkButtons() {
  pressedButton = -1; 

  for (int i = 0; i < 9; i++) {
    bool currentState = digitalRead(buttonPins[i]);
    
    /* Detect falling edge (HIGH -> LOW transition) */
    if (game.getLastButtonState(i) == HIGH && currentState == LOW) {
      pressedButton = i; 
    }
    
    /* Store state for debounce/edge detection */
    game.setLastButtonState(i, currentState);
  }
}

