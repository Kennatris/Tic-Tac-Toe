/*
 * Intro Animation
 * Runs once when the game starts or resets.
 */
void advancedSetupAnimation() {
  const int pauseTime = 400; 

  /* Status LED blinking logic during setup */
  auto blinkStatus = [&](CRGB color) {
      statusLed[0] = color;
      FastLED.show();
  };

  /* Pattern 1: Red X (Status Red) */
  blinkStatus(CRGB::Red);
  leds[0] = CRGB::Red;   leds[1] = CRGB::Black; leds[2] = CRGB::Red;
  leds[3] = CRGB::Black; leds[4] = CRGB::Red;   leds[5] = CRGB::Black;
  leds[6] = CRGB::Red;   leds[7] = CRGB::Black; leds[8] = CRGB::Red;
  FastLED.show();
  delay(pauseTime);

  /* Pattern 2: Blue Circle (Status Blue) */
  blinkStatus(CRGB::Blue);
  leds[0] = CRGB::Blue;   leds[1] = CRGB::Blue;  leds[2] = CRGB::Blue;
  leds[3] = CRGB::Blue;   leds[4] = CRGB::Black; leds[5] = CRGB::Blue;
  leds[6] = CRGB::Blue;   leds[7] = CRGB::Blue;  leds[8] = CRGB::Blue;
  FastLED.show();
  delay(pauseTime);

  /* Pattern 3: Red X (Status Red) */
  blinkStatus(CRGB::Red);
  leds[0] = CRGB::Red;   leds[1] = CRGB::Black; leds[2] = CRGB::Red;
  leds[3] = CRGB::Black; leds[4] = CRGB::Red;   leds[5] = CRGB::Black;
  leds[6] = CRGB::Red;   leds[7] = CRGB::Black; leds[8] = CRGB::Red;
  FastLED.show();
  delay(pauseTime);

  /* Pattern 4: Blue Circle (Status Blue) */
  blinkStatus(CRGB::Blue);
  leds[0] = CRGB::Blue;   leds[1] = CRGB::Blue;  leds[2] = CRGB::Blue;
  leds[3] = CRGB::Blue;   leds[4] = CRGB::Black; leds[5] = CRGB::Blue;
  leds[6] = CRGB::Blue;   leds[7] = CRGB::Blue;  leds[8] = CRGB::Blue;
  FastLED.show();
  delay(pauseTime);

  /* Clear */
  for (int i = 0; i < 9; i++) ledBlack(i);
  FastLED.show();

  /* Pattern 5: Checkerboard Fill */
  for (int i = 0; i < 9; i++) {
      leds[i] = i % 2 ? CRGB::Red : CRGB::Blue;
      /* Fast alternating status blink */
      statusLed[0] = (i % 2) ? CRGB::Red : CRGB::Blue;
      FastLED.show();
      delay(pauseTime/3);
  } 

  /* Final Clear */
  for (int i = 0; i < 9; i++) ledBlack(i);
  statusLed[0] = CRGB::Black; /* Reset status led */
  FastLED.show();
}

/*
 * Victory Animation
 * Blinks the winning line.
 */
void victoryAnimation(int winningLine[3], bool winnerIs) {
  CRGB winColor = winnerIs ? CRGB::Red : CRGB::Blue;

  for (int blink = 0; blink < 5; blink++) {
    /* Line ON */
    for (int i = 0; i < 3; i++) {
      leds[winningLine[i]] = winColor;
    }
    FastLED.show();
    delay(300);

    /* Line OFF */
    for (int i = 0; i < 3; i++) {
      leds[winningLine[i]] = CRGB::Black;
    }
    FastLED.show();
    delay(300);
  }
}

/*
 * Draw/Tie Animation
 * Blinks the entire board.
 */
void drawAnimation() {
  CRGB ledCurrentState[NUM_LEDS];

  /* Save State */
  for (int led = 0; led < NUM_LEDS; led++) {
      ledCurrentState[led] = leds[led];
  }

  for (int blink = 0; blink < 3; blink++) {
    /* All OFF */
    for (int i = 0; i < 9; i++) ledBlack(i);
    FastLED.show();
    delay(300);

    /* Restore */
    for (int i = 0; i < 9; i++) {
      leds[i] = ledCurrentState[i];
    }
    FastLED.show();
    delay(300);
  }

  /* Final Clear */
  for (int i = 0; i < 9; i++) ledBlack(i);
  FastLED.show();
}

