#include "TicTacToe.h"
#include <FastLED.h>

/* -------------------------------------------------------------------------- */
/* 1. CONFIGURATION & VARIABLES (GLOBALS)                                     */
/* -------------------------------------------------------------------------- */

/* LED Configuration */
#define STRIP_PIN     6
#define STATUS_LED_PIN 5     /* Status LED Pin */
#define NUM_LEDS      9
#define BRIGHTNESS    150
#define LED_TYPE      WS2812B
#define COLOR_ORDER   GRB

CRGB leds[NUM_LEDS];
CRGB statusLed[1];           /* Array for the single status LED */

/* Button Configuration */
/* Mapping order: C1, C2, C3, B1, B2, B3, A1, A2, A3 */
int buttonPins[9];

/* Control Pins */
#define POT_PIN       A0     /* Error Rate Control */
#define MODE_SWITCH_PIN A1   /* Game Mode Switch */
#define RESET_PIN     A2     /* Reset Button */

/* Game Objects & State */
TicTacToe game;
bool isSetupDone = false;

/* Student-accessible variables */
bool currentPlayer = true;    /* true = Player X, false = Player O */
bool playerChanged = false;   /* Flag: Turn change occurred */
int pressedButton = -1;       /* Index of pressed button (-1 = none) */

/* Forward declaration of internal helper */
void advancedSetup(); 

/* -------------------------------------------------------------------------- */
/* 2. MAIN ARDUINO FUNCTIONS (SETUP & LOOP)                                   */
/* -------------------------------------------------------------------------- */

void setup() {
  /* Initialize Hardware */
  fastLedSetup();
  setPins();

  /* Initialize Game Engine */
  game.begin(
    buttonPins,
    RESET_PIN,
    MODE_SWITCH_PIN,
    POT_PIN,          
    leds,
    statusLed,        
    &currentPlayer,
    &playerChanged,
    &pressedButton,
    &isSetupDone 
  );

  /* Link Callbacks to Student Functions */
  game.onVictory      = victoryAnimation;
  game.onDraw         = drawAnimation;
  game.onReset        = advancedSetup;
  game.onResetPlayer  = resetPlayer;
  game.onChangePlayer = changePlayer;
  game.onCheckButtons = checkButtons;

  /* Run Initial Setup */
  advancedSetup();
}

void loop() {
  game.update();
}

