/*
 * Wrapper for the setup animation to ensure it runs only when needed.
 */
void advancedSetup() {
  if (!isSetupDone) {
    advancedSetupAnimation();
    isSetupDone = true;  
  }

  for (int i = 0; i < 9; i++) {
    ledBlack(i);
  }
  FastLED.show();
}